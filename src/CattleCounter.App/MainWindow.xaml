<Window x:Class="CattleCounter.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Cattle Casualty Counter" Width="390" Height="430"
 Background="#15191F" Foreground="#F5F5F5"
 WindowStyle="ToolWindow" ResizeMode="CanMinimize" Topmost="True">
 <StackPanel Margin="18">
  <TextBlock Text="CATTLE CASUALTY COUNTER" FontSize="19" FontWeight="Bold"/>
  <TextBlock Text="SIMULATED DRIVING - NOT CONNECTED TO ETS2" Foreground="#F4B35E" FontSize="11" Margin="0,6,0,16"/>
  <UniformGrid Columns="3" Margin="0,0,0,16">
   <StackPanel><TextBlock Text="LOADED"/><TextBlock x:Name="LoadedText" Text="30" FontSize="30"/></StackPanel>
   <StackPanel><TextBlock Text="ALIVE"/><TextBlock x:Name="AliveText" Text="30" FontSize="30" Foreground="#7ADBA6"/></StackPanel>
   <StackPanel><TextBlock Text="DEAD"/><TextBlock x:Name="DeadText" Text="0" FontSize="30" Foreground="#F17F7F"/></StackPanel>
  </UniformGrid>
  <TextBlock Text="Incident log" FontWeight="Bold" Margin="0,0,0,8"/>
  <ListBox x:Name="IncidentList" Height="155" Background="#232A33" Foreground="White" BorderThickness="0"/>
  <WrapPanel Margin="0,16,0,0">
   <Button Content="Bad turn" Click="BadTurn_Click" Padding="12,7" Margin="0,0,7,7"/>
   <Button Content="Hard brake" Click="HardBrake_Click" Padding="12,7" Margin="0,0,7,7"/>
   <Button Content="Crash" Click="Crash_Click" Padding="12,7" Margin="0,0,7,7"/>
   <Button Content="Reset delivery" Click="Reset_Click" Padding="12,7"/>
  </WrapPanel>
 </StackPanel>
</Window>
